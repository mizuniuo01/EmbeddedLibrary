{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "host-gcc",
            "inherits": "host-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-13"
            }
        },
        {
            "name": "host-clang",
            "inherits": "host-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-21"
            }
        },
        {
            "name": "host-sanitize",
            "inherits": "host-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-21",
                "EMBEDDEDLIB_ENABLE_SANITIZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        {"name": "host-gcc", "configurePreset": "host-gcc"},
        {"name": "host-clang", "configurePreset": "host-clang"},
        {"name": "host-sanitize", "configurePreset": "host-sanitize"}
    ],
    "testPresets": [
        {
            "name": "host-gcc",
            "configurePreset": "host-gcc",
            "output": {"outputOnFailure": true},
            "execution": {"noTestsAction": "error", "stopOnFailure": true}
        },
        {
            "name": "host-clang",
            "configurePreset": "host-clang",
            "output": {"outputOnFailure": true},
            "execution": {"noTestsAction": "error", "stopOnFailure": true}
        },
        {
            "name": "host-sanitize",
            "configurePreset": "host-sanitize",
            "output": {"outputOnFailure": true},
            "execution": {"noTestsAction": "error", "stopOnFailure": true}
        }
    ]
}
